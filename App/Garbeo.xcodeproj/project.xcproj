{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Version.xcconfig" },
    { "name": "Release", "file": "Version.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "..",
    }, {
      "kind": "remote",
      "repository": "https://github.com/almonk/bonsplit.git",
      "version": {
        "up-to-next-major-version": "1.1.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/textual",
      "version": {
        "up-to-next-minor-version": "0.5.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Resources", "target-membership": [ "Garbeo" ] },
    { "kind": "folder", "path": "Garbeo", "target-membership": [ "Garbeo" ] },
    { "path": "Info.plist" },
    { "path": "Version.xcconfig" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Garbeo.app", "id": "AB12CD34EF56000000000007", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Garbeo",
      "id": "AB12CD34EF56000000000013",
      "product": "Products/Garbeo.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "GarbeoSyntax",
