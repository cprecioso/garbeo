require "shellwords"

default_platform(:ios)

VERSION_XCCONFIG = File.expand_path("../Version.xcconfig", __dir__)
PROJECT = File.expand_path("../Garbeo.xcodeproj", __dir__)
BUILD_DIR = File.expand_path("../build", __dir__)

# CI has no logged-in Apple ID or Xcode account, so it authenticates with an App Store Connect API key
ASC_KEY_PATH = ENV["ASC_KEY_PATH"]

before_all do
  setup_ci if is_ci
  if ASC_KEY_PATH
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ASC_KEY_PATH
    )
  end
end

def xcodebuild_args
  args = ["-allowProvisioningUpdates"]
  # CI can't click "Trust & Enable" for SwiftTerm's build plugin
  args << "-skipPackagePluginValidation" if is_ci
  if ASC_KEY_PATH
    args += [
      "-authenticationKeyPath", ASC_KEY_PATH,
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    ]
  end
  args.shelljoin
end

desc "Set the build number to one above the latest iOS or macOS TestFlight build"
lane :bump_build_number do
  latest = %w[ios osx].map do |platform|
    latest_testflight_build_number(platform: platform, initial_build_number: 0).to_i
  end.max
  update_xcconfig_value(path: VERSION_XCCONFIG, name: "CURRENT_PROJECT_VERSION", value: (latest + 1).to_s)
end

# gym can't read the Xcode 27 project.xcproj format, so call xcodebuild directly
# https://github.com/CocoaPods/Xcodeproj/issues/1052
def archive_and_export(platform:, artifact:)
  build_dir = File.join(BUILD_DIR, platform)
  sh("rm", "-rf", build_dir)
  xcarchive(
    project: PROJECT,
    scheme: "Garbeo",
    configuration: "Release",
    destination: "generic/platform=#{platform}",
    archive_path: File.join(build_dir, "Garbeo.xcarchive"),
    xcargs: xcodebuild_args
  )
  xcexport(
    export_path: build_dir,
    export_options_plist: {
      method: "app-store-connect",
      destination: "export",
      signingStyle: "automatic",
      uploadSymbols: true,
      # bump_build_number owns the build number
      manageAppVersionAndBuildNumber: false
    },
    xcargs: xcodebuild_args
  )
  File.join(build_dir, artifact)
end

platform :ios do
  desc "Archive and export an App Store .ipa"
  lane :build do
    archive_and_export(platform: "iOS", artifact: "Garbeo.ipa")
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    bump_build_number
    upload_to_testflight(ipa: build, skip_waiting_for_build_processing: is_ci)
  end
end

platform :mac do
  desc "Archive and export an App Store .pkg"
  lane :build do
    archive_and_export(platform: "macOS", artifact: "Garbeo.pkg")
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    bump_build_number
    upload_to_testflight(pkg: build, app_platform: "osx", skip_waiting_for_build_processing: is_ci)
  end
end
