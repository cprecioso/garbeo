{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "..",
    }, {
      "kind": "remote",
      "repository": "https://github.com/almonk/bonsplit.git",
      "version": {
        "up-to-next-major-version": "1.1.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/textual",
      "version": {
        "up-to-next-minor-version": "0.5.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "PaseoSwift", "target-membership": [ "PaseoSwift" ] },
    { "path": "Info.plist" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Garbeo.app", "id": "AB12CD34EF56000000000007", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "PaseoSwift",
      "id": "AB12CD34EF56000000000013",
      "product": "Products/Garbeo.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "PaseoKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PaseoTerminal",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PaseoSyntax",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "bonsplit",
          "product-name": "Bonsplit",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "macos" ] },
        }, {
          "package": "textual",
          "product-name": "Textual",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Garbeo",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortraitUpsideDown",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "0.1.0", // x-release-please-version
        "PRODUCT_BUNDLE_IDENTIFIER": "design.precioso.garbeo",
        "PRODUCT_NAME": "Garbeo",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
